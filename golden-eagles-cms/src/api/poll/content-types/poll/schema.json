{
  "kind": "collectionType",
  "collectionName": "polls",
  "info": {
    "singularName": "poll",
    "pluralName": "polls",
    "displayName": "Poll"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "active": {
      "type": "boolean",
      "required": true,
      "default": true
    },
    "endsAt": {
      "type": "datetime"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "options": {
      "type": "component",
      "component": "poll.option",
      "repeatable": true,
      "required": true,
      "min": 2
    }
  }
}
